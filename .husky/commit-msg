#!/bin/sh

set -e

commit_msg_file="$1"
commit_msg="$(cat "$commit_msg_file")"

case "$commit_msg" in
  Merge\ *) exit 0 ;;
  Revert\ *) exit 0 ;;
esac

if printf '%s' "$commit_msg" | grep -Eq '^(feat|fix|docs|style|refactor|test|chore|build|ci|perf|revert)(\([^)]+\))?: .+'; then
  exit 0
fi

printf '%s\n' "Invalid commit message."
printf '%s\n' "Use a conventional commit format like: feat: add login page"
printf '%s\n' "Allowed types: feat, fix, docs, style, refactor, test, chore, build, ci, perf, revert"
exit 1
