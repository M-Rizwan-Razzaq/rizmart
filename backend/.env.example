# MongoDB Atlas or local Mongo
# The backend accepts either MONGODB_URI or MONGO_URI.
MONGODB_URI=
MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
RESET_TOKEN_SECRET=
RESET_TOKEN_EXPIRES_IN=1h
PORT=3000
APP_URL=
# Public site URL — used to build canonical links and the dynamic /sitemap.xml
SITE_URL=
UPLOAD_DIR=uploads
NODE_ENV=development

# Notifications
RESEND_API_KEY=
# Optional SMTP fallback if you do not use Resend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_FROM_ORDERS=
EMAIL_FROM_OFFERS=
ORDER_ADMIN_EMAIL=


# Cloudflare R2 (S3-compatible image storage)
R2_BUCKET=your-bucket-name
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-<hash>.r2.dev
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key
